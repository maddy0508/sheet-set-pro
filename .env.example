# Copy to .env.local for a build that talks to the shared workspace.
# Both values come from the Supabase project settings (Project URL and the publishable/anon key).
# Only a publishable key belongs in a browser build: row level security does the rest.
# A service-role key must never appear in frontend code or in this file.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-or-anon-key>
